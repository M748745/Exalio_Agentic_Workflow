{
  "id": "chat_assistant_003",
  "name": "Multi-turn Chat Assistant",
  "description": "Conversational AI with memory. Uses context_get to retrieve conversation history, generates response, and stores with context_append for coherent multi-turn dialogues.",
  "category": "Conversational AI",
  "difficulty": "Beginner",
  "tags": ["chat", "context", "conversation", "memory", "assistant"],
  "author": "Agentic Workflow Builder",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "user_message",
      "type": "text_input",
      "data": {
        "label": "Your Message",
        "nodeType": "text_input",
        "category": "Input"
      },
      "position": { "x": 100, "y": 200 }
    },
    {
      "id": "context_get_1",
      "type": "context_get",
      "data": {
        "label": "Get Conversation History",
        "nodeType": "context_get",
        "category": "Memory",
        "config": {
          "contextId": "chat_session_1",
          "lastN": 10
        }
      },
      "position": { "x": 300, "y": 200 }
    },
    {
      "id": "append_user",
      "type": "context_append",
      "data": {
        "label": "Store User Message",
        "nodeType": "context_append",
        "category": "Memory",
        "config": {
          "contextId": "chat_session_1",
          "role": "user",
          "content": "{{user_message.text}}"
        }
      },
      "position": { "x": 500, "y": 200 }
    },
    {
      "id": "ollama_chat",
      "type": "ollama_llm",
      "data": {
        "label": "Generate Response",
        "nodeType": "ollama_llm",
        "category": "LLM Providers",
        "config": {
          "model": "llama3.2:3b",
          "systemPrompt": "You are a helpful, friendly AI assistant. Use the conversation history to provide contextual responses. Remember what the user said before.",
          "temperature": 0.8,
          "maxTokens": 500
        }
      },
      "position": { "x": 700, "y": 200 }
    },
    {
      "id": "append_assistant",
      "type": "context_append",
      "data": {
        "label": "Store Assistant Response",
        "nodeType": "context_append",
        "category": "Memory",
        "config": {
          "contextId": "chat_session_1",
          "role": "assistant",
          "content": "{{ollama_chat.response}}"
        }
      },
      "position": { "x": 900, "y": 200 }
    },
    {
      "id": "display_response",
      "type": "display",
      "data": {
        "label": "Show Response",
        "nodeType": "display",
        "category": "Output",
        "config": {
          "message": "Assistant: {{ollama_chat.response}}\n\n[Conversation has {{append_assistant.message_count}} messages]"
        }
      },
      "position": { "x": 1100, "y": 200 }
    },
    {
      "id": "display_history",
      "type": "display",
      "data": {
        "label": "Show History (Optional)",
        "nodeType": "display",
        "category": "Output",
        "config": {
          "message": "Recent conversation:\n{{context_get_1.history}}"
        }
      },
      "position": { "x": 500, "y": 50 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "user_message", "target": "context_get_1" },
    { "id": "e2", "source": "context_get_1", "target": "append_user" },
    { "id": "e3", "source": "context_get_1", "target": "display_history" },
    { "id": "e4", "source": "append_user", "target": "ollama_chat" },
    { "id": "e5", "source": "ollama_chat", "target": "append_assistant" },
    { "id": "e6", "source": "append_assistant", "target": "display_response" }
  ],
  "metadata": {
    "createdAt": "2026-09-12",
    "estimatedRuntime": "2-8 seconds per message",
    "requirements": ["Ollama with llama3.2:3b model"],
    "useCases": [
      "Customer support chatbots",
      "Personal AI assistants",
      "Interactive tutoring systems",
      "Conversational interfaces"
    ],
    "notes": "Run this workflow multiple times with different messages. The assistant will remember previous context and provide coherent responses."
  }
}
