{
  "id": "email_automation_005",
  "name": "Smart Email Automation",
  "description": "Intelligent email routing based on sentiment analysis. Analyzes incoming message sentiment using LLM, categorizes as positive/negative/neutral, and routes to appropriate handler with customized responses.",
  "category": "Automation & Notifications",
  "difficulty": "Beginner",
  "tags": ["email", "sentiment", "automation", "routing", "llm", "notifications"],
  "author": "Agentic Workflow Builder",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "email_input",
      "type": "text_input",
      "data": {
        "label": "Incoming Email/Message",
        "nodeType": "text_input",
        "category": "Input"
      },
      "position": { "x": 100, "y": 250 }
    },
    {
      "id": "sentiment_analysis",
      "type": "ollama_llm",
      "data": {
        "label": "Analyze Sentiment",
        "nodeType": "ollama_llm",
        "category": "LLM Providers",
        "config": {
          "model": "llama3.2:3b",
          "systemPrompt": "Analyze the sentiment of the following message and respond with ONLY ONE WORD: 'positive', 'negative', or 'neutral'. Consider tone, urgency, and emotional context.",
          "temperature": 0.2,
          "maxTokens": 10
        }
      },
      "position": { "x": 300, "y": 250 }
    },
    {
      "id": "extract_priority",
      "type": "ollama_llm",
      "data": {
        "label": "Determine Priority",
        "nodeType": "ollama_llm",
        "category": "LLM Providers",
        "config": {
          "model": "llama3.2:3b",
          "systemPrompt": "Assess the priority/urgency of this message. Respond with ONLY ONE WORD: 'high', 'medium', or 'low'. Consider deadlines, keywords like 'urgent', 'ASAP', complaints, or escalations.",
          "temperature": 0.1,
          "maxTokens": 10
        }
      },
      "position": { "x": 500, "y": 250 }
    },
    {
      "id": "route_sentiment",
      "type": "if_else",
      "data": {
        "label": "Is Negative?",
        "nodeType": "if_else",
        "category": "Control Flow",
        "config": {
          "condition": "sentiment_analysis.response.includes('negative')"
        }
      },
      "position": { "x": 700, "y": 250 }
    },
    {
      "id": "escalate_negative",
      "type": "notification",
      "data": {
        "label": "Escalate to Manager",
        "nodeType": "notification",
        "category": "Output",
        "config": {
          "type": "email",
          "to": "manager@company.com",
          "subject": "🚨 Urgent: Negative Feedback Received",
          "body": "Priority: {{extract_priority.response}}\\n\\nOriginal Message:\\n{{email_input.text}}\\n\\nSentiment: {{sentiment_analysis.response}}\\n\\nPlease review and respond promptly."
        }
      },
      "position": { "x": 900, "y": 150 }
    },
    {
      "id": "generate_response",
      "type": "ollama_llm",
      "data": {
        "label": "Generate Auto-Response",
        "nodeType": "ollama_llm",
        "category": "LLM Providers",
        "config": {
          "model": "llama3.2:3b",
          "systemPrompt": "Generate a professional, empathetic email response to the following message. Keep it concise (2-3 sentences), acknowledge their input, and provide next steps if applicable.",
          "temperature": 0.7,
          "maxTokens": 150
        }
      },
      "position": { "x": 900, "y": 350 }
    },
    {
      "id": "log_interaction",
      "type": "context_append",
      "data": {
        "label": "Log to CRM",
        "nodeType": "context_append",
        "category": "Memory",
        "config": {
          "contextId": "email_interactions",
          "role": "system",
          "content": "Timestamp: {{timestamp}}\\nSentiment: {{sentiment_analysis.response}}\\nPriority: {{extract_priority.response}}\\nMessage: {{email_input.text}}\\nResponse: {{generate_response.response}}"
        }
      },
      "position": { "x": 1100, "y": 250 }
    },
    {
      "id": "send_response",
      "type": "notification",
      "data": {
        "label": "Send Auto-Reply",
        "nodeType": "notification",
        "category": "Output",
        "config": {
          "type": "email",
          "to": "{{email_input.sender}}",
          "subject": "Re: Your Message",
          "body": "{{generate_response.response}}\\n\\n---\\nThis is an automated response. A team member will follow up if needed."
        }
      },
      "position": { "x": 1300, "y": 350 }
    },
    {
      "id": "summary_display",
      "type": "display",
      "data": {
        "label": "Processing Summary",
        "nodeType": "display",
        "category": "Output",
        "config": {
          "message": "📧 Email Automation Complete\\n\\n📊 Analysis:\\n  • Sentiment: {{sentiment_analysis.response}}\\n  • Priority: {{extract_priority.response}}\\n  • Action: {{route_sentiment.branch}}\\n\\n✉️ Response Generated:\\n{{generate_response.response}}\\n\\n✅ Logged to CRM: {{log_interaction.message_count}} total interactions"
        }
      },
      "position": { "x": 1500, "y": 250 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "email_input", "target": "sentiment_analysis" },
    { "id": "e2", "source": "email_input", "target": "extract_priority" },
    { "id": "e3", "source": "sentiment_analysis", "target": "route_sentiment" },
    { "id": "e4", "source": "extract_priority", "target": "route_sentiment" },
    { "id": "e5", "source": "route_sentiment", "target": "escalate_negative", "sourceHandle": "true" },
    { "id": "e6", "source": "route_sentiment", "target": "generate_response", "sourceHandle": "false" },
    { "id": "e7", "source": "escalate_negative", "target": "log_interaction" },
    { "id": "e8", "source": "generate_response", "target": "log_interaction" },
    { "id": "e9", "source": "log_interaction", "target": "send_response" },
    { "id": "e10", "source": "send_response", "target": "summary_display" }
  ],
  "metadata": {
    "createdAt": "2026-09-12",
    "estimatedRuntime": "3-8 seconds per email",
    "requirements": [
      "Ollama with llama3.2:3b model",
      "Email/notification service configured"
    ],
    "useCases": [
      "Customer support email triage",
      "Automated feedback processing",
      "Help desk ticket routing",
      "Social media message management",
      "Community forum moderation"
    ],
    "notes": "This workflow demonstrates intelligent message processing with AI-powered sentiment analysis and conditional routing. Negative feedback is escalated to management while neutral/positive messages receive automated responses. All interactions are logged for CRM tracking and analytics."
  }
}
