  {
    "id": "template_llm_chatbot",
    "name": "AI Chatbot with Context",
    "description": "Chatbot workflow with conversation context and vector search",
    "category": "AI & LLM",
    "tags": ["llm", "chatbot", "rag", "context"],
    "difficulty": "advanced",
    "use_cases": ["Customer Support", "Q&A Bot", "Documentation Assistant"],
    "nodes": [
      {
        "id": "input_1",
        "type": "input",
        "position": {"x": 100, "y": 200},
        "data": {
          "label": "User Message",
          "nodeType": "input",
          "category": "Input",
          "inputType": "text",
          "description": "User's question or message"
        }
      },
      {
        "id": "vector_search_1",
        "type": "custom",
        "position": {"x": 350, "y": 100},
        "data": {
          "label": "Search Knowledge Base",
          "nodeType": "vector_search",
          "category": "Memory",
          "collection": "knowledge_base",
          "nResults": 3,
          "description": "Retrieves relevant context"
        }
      },
      {
        "id": "context_get_1",
        "type": "custom",
        "position": {"x": 350, "y": 300},
        "data": {
          "label": "Get Conversation History",
          "nodeType": "context_get",
          "category": "Memory",
          "contextId": "default",
          "lastN": 5,
          "description": "Gets recent messages"
        }
      },
      {
        "id": "llm_1",
        "type": "custom",
        "position": {"x": 650, "y": 200},
        "data": {
          "label": "Generate Response",
          "nodeType": "ollama_llm",
          "category": "LLM Providers",
          "model": "llama3.2:3b",
          "systemPrompt": "You are a helpful assistant. Use the provided context to answer questions accurately.",
          "temperature": 0.7,
          "maxTokens": 2000,
          "description": "Generates AI response"
        }
      },
      {
        "id": "context_append_1",
        "type": "custom",
        "position": {"x": 950, "y": 200},
        "data": {
          "label": "Save to History",
          "nodeType": "context_append",
          "category": "Memory",
          "contextId": "default",
          "role": "assistant",
          "description": "Saves response to history"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "input_1",
        "target": "vector_search_1",
        "type": "smoothstep"
      },
      {
        "id": "e2",
        "source": "input_1",
        "target": "context_get_1",
        "type": "smoothstep"
      },
      {
        "id": "e3",
        "source": "vector_search_1",
        "target": "llm_1",
        "type": "smoothstep"
      },
      {
        "id": "e4",
        "source": "context_get_1",
        "target": "llm_1",
        "type": "smoothstep"
      },
      {
        "id": "e5",
        "source": "llm_1",
        "target": "context_append_1",
        "type": "smoothstep"
      }
    ]
  },
  {
    "id": "template_api_monitor",
    "name": "API Monitoring & Alerts",
    "description": "Monitor API endpoint and send alerts if it fails",
    "category": "Monitoring",
    "tags": ["api", "monitoring", "alerts", "slack"],
    "difficulty": "intermediate",
    "use_cases": ["Health Checks", "Uptime Monitoring", "SLA Tracking"],
    "nodes": [
      {
        "id": "api_1",
        "type": "custom",
        "position": {"x": 100, "y": 200},
        "data": {
          "label": "Check API Health",
          "nodeType": "api_integration",
          "category": "API Integration",
          "apiUrl": "https://api.example.com/health",
          "method": "GET",
          "enableRetry": "true",
          "maxRetries": 3,
          "description": "Checks API status"
        }
      },
      {
        "id": "condition_1",
        "type": "custom",
        "position": {"x": 400, "y": 200},
        "data": {
          "label": "Check Status",
          "nodeType": "if_else",
          "category": "Control Flow",
          "condition": "data.status_code >= 400",
          "description": "Checks if API failed"
        }
      },
      {
        "id": "slack_1",
        "type": "custom",
        "position": {"x": 700, "y": 100},
        "data": {
          "label": "Send Alert",
          "nodeType": "slack_node",
          "category": "Integration & Connectivity",
          "method": "webhook",
          "message": "⚠️ API Health Check Failed!\\nStatus: {{status_code}}\\nError: {{error}}",
          "username": "Monitor Bot",
          "icon_emoji": ":warning:",
          "description": "Sends Slack alert"
        }
      },
      {
        "id": "cache_1",
        "type": "custom",
        "position": {"x": 700, "y": 300},
        "data": {
          "label": "Log Success",
          "nodeType": "cache_set",
          "category": "Memory",
          "key": "last_success",
          "ttl": 3600,
          "description": "Caches last success time"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "api_1",
        "target": "condition_1",
        "type": "smoothstep"
      },
      {
        "id": "e2",
        "source": "condition_1",
        "target": "slack_1",
        "type": "smoothstep",
        "label": "Failed"
      },
      {
        "id": "e3",
        "source": "condition_1",
        "target": "cache_1",
        "type": "smoothstep",
        "label": "Success"
      }
    ]
  },
