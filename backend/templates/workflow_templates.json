  {
    "id": "template_data_pipeline",
    "name": "Data Processing Pipeline",
    "description": "Load data from database, transform it, and save results",
    "category": "Data Processing",
    "tags": ["database", "transformation", "etl"],
    "difficulty": "intermediate",
    "use_cases": ["ETL", "Data Migration", "Reporting"],
    "nodes": [
      {
        "id": "db_load_1",
        "type": "custom",
        "position": {"x": 100, "y": 200},
        "data": {
          "label": "Load from Database",
          "nodeType": "mysql",
          "category": "Data Loaders",
          "host": "localhost",
          "port": 3306,
          "query": "SELECT * FROM users WHERE active = 1",
          "description": "Loads data from MySQL"
        }
      },
      {
        "id": "transform_1",
        "type": "custom",
        "position": {"x": 400, "y": 200},
        "data": {
          "label": "Transform Data",
          "nodeType": "python_script",
          "category": "Data Transformation",
          "pythonScript": "def transform(data):\n    # Transform your data here\n    return data",
          "description": "Transforms the data"
        }
      },
      {
        "id": "output_1",
        "type": "output",
        "position": {"x": 700, "y": 200},
        "data": {
          "label": "Save Results",
          "nodeType": "output",
          "category": "Output",
          "outputFormat": "json",
          "destination": "output/results.json",
          "description": "Saves processed data"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "db_load_1",
        "target": "transform_1",
        "type": "smoothstep"
      },
      {
        "id": "e2",
        "source": "transform_1",
        "target": "output_1",
        "type": "smoothstep"
      }
    ]
