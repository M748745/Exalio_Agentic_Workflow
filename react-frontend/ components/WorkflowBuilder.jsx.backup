              {/* File Parsers Configuration */}
              {selectedNode.data.category === 'File Parsers' && (
                <>
                  <div className="config-section-header">📄 Parser Configuration</div>

                  <div className="config-field">
                    <label>File Path/URL</label>
                    <input
                      type="text"
                      value={selectedNode.data.filePath || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { filePath: e.target.value })}
