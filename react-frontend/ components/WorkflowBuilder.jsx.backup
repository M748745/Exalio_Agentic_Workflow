                      <option value="structured">Structured Data</option>
                      <option value="tables">Tables</option>
                      <option value="images">Images</option>
                      <option value="all">All Content</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Custom Parser Config (JSON)</label>
                    <textarea
                      value={selectedNode.data.parserConfig || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { parserConfig: e.target.value })}
                      rows={4}
                      placeholder='{"encoding": "utf-8", "pages": "1-10"}'
                      style={{ fontFamily: 'Consolas, Monaco, monospace', fontSize: '13px' }}
                    />
                  </div>
                </>
              )}

              {/* RAG & Evaluation Configuration */}
              {selectedNode.data.category === 'RAG & Evaluation' && (
                <>
                  <div className="config-section-header">🔍 RAG Configuration</div>

                  <div className="config-field">
                    <label>Vector Database</label>
                    <select
                      value={selectedNode.data.vectorDb || 'chromadb'}
                      onChange={(e) => updateNodeData(selectedNode.id, { vectorDb: e.target.value })}
                    >
                      <option value="chromadb">ChromaDB</option>
                      <option value="pinecone">Pinecone</option>
                      <option value="weaviate">Weaviate</option>
                      <option value="qdrant">Qdrant</option>
                      <option value="faiss">FAISS</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Embedding Model</label>
                    <input
                      type="text"
                      value={selectedNode.data.embeddingModel || 'text-embedding-ada-002'}
                      onChange={(e) => updateNodeData(selectedNode.id, { embeddingModel: e.target.value })}
                      placeholder="text-embedding-ada-002"
                    />
                  </div>

                  <div className="config-row">
                    <div className="config-field">
                      <label>Top K Results</label>
                      <input
                        type="number"
                        value={selectedNode.data.topK || 5}
                        onChange={(e) => updateNodeData(selectedNode.id, { topK: parseInt(e.target.value) })}
                      />
                    </div>
                    <div className="config-field">
                      <label>Similarity Threshold</label>
                      <input
                        type="number"
                        min="0"
                        max="1"
                        step="0.01"
                        value={selectedNode.data.similarityThreshold || 0.7}
                        onChange={(e) => updateNodeData(selectedNode.id, { similarityThreshold: parseFloat(e.target.value) })}
                      />
                    </div>
                  </div>
                </>
              )}

              {/* Guardrails & Security Configuration */}
              {selectedNode.data.category === 'Guardrails & Security' && (
                <>
                  <div className="config-section-header">🛡️ Security Configuration</div>

                  <div className="config-field">
                    <label>Detection Sensitivity</label>
                    <select
                      value={selectedNode.data.sensitivity || 'medium'}
                      onChange={(e) => updateNodeData(selectedNode.id, { sensitivity: e.target.value })}
                    >
                      <option value="low">Low (Fast)</option>
                      <option value="medium">Medium (Balanced)</option>
                      <option value="high">High (Strict)</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Action on Violation</label>
                    <select
                      value={selectedNode.data.violationAction || 'block'}
                      onChange={(e) => updateNodeData(selectedNode.id, { violationAction: e.target.value })}
                    >
                      <option value="block">Block Request</option>
                      <option value="redact">Redact Sensitive Data</option>
                      <option value="warn">Warn & Continue</option>
                      <option value="log">Log Only</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Custom Rules (JSON)</label>
                    <textarea
                      value={selectedNode.data.customRules || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { customRules: e.target.value })}
                      rows={5}
                      placeholder='{"blocked_patterns": [], "allowed_domains": []}'
                      style={{ fontFamily: 'Consolas, Monaco, monospace', fontSize: '13px' }}
                    />
                  </div>
                </>
              )}

              {/* Chatbot Builder Configuration */}
              {selectedNode.data.category === 'Chatbot Builder' && (
                <>
                  <div className="config-section-header">💬 Chatbot Configuration</div>

                  <div className="config-field">
                    <label>Intent/State Name</label>
                    <input
                      type="text"
                      value={selectedNode.data.intentName || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { intentName: e.target.value })}
                      placeholder="greeting, booking, order_status"
                    />
                  </div>

                  <div className="config-field">
                    <label>Training Phrases (one per line)</label>
                    <textarea
                      value={selectedNode.data.trainingPhrases || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { trainingPhrases: e.target.value })}
                      rows={5}
                      placeholder="Hello\nHi there\nGood morning"
                    />
                  </div>

                  <div className="config-field">
                    <label>Response Template</label>
                    <textarea
                      value={selectedNode.data.responseTemplate || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { responseTemplate: e.target.value })}
                      rows={3}
                      placeholder="Hello! How can I help you today?"
                    />
                  </div>
                </>
              )}

              {/* Integration & Connectivity Configuration */}
              {selectedNode.data.category === 'Integration & Connectivity' && (
                <>
                  <div className="config-section-header">🌐 Integration Configuration</div>

                  <div className="config-field">
                    <label>API Endpoint/Service URL</label>
                    <input
                      type="text"
                      value={selectedNode.data.serviceUrl || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { serviceUrl: e.target.value })}
                      placeholder="https://api.service.com/endpoint"
                    />
                  </div>

                  <div className="config-field">
                    <label>Authentication Type</label>
                    <select
                      value={selectedNode.data.authType || 'none'}
                      onChange={(e) => updateNodeData(selectedNode.id, { authType: e.target.value })}
                    >
                      <option value="none">None</option>
                      <option value="api_key">API Key</option>
                      <option value="bearer">Bearer Token</option>
                      <option value="oauth">OAuth 2.0</option>
                      <option value="basic">Basic Auth</option>
                    </select>
                  </div>

                  {selectedNode.data.authType && selectedNode.data.authType !== 'none' && (
                    <div className="config-field">
                      <label>API Key / Token</label>
                      <input
                        type="password"
                        value={selectedNode.data.apiKey || ''}
                        onChange={(e) => updateNodeData(selectedNode.id, { apiKey: e.target.value })}
                        placeholder="Enter your API key"
                      />
                    </div>
                  )}

                  <div className="config-field">
                    <label>Request Body (JSON)</label>
                    <textarea
                      value={selectedNode.data.requestBody || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { requestBody: e.target.value })}
                      rows={5}
                      placeholder='{"key": "value"}'
                      style={{ fontFamily: 'Consolas, Monaco, monospace', fontSize: '13px' }}
                    />
                  </div>
                </>
              )}

              {/* Scheduling & Triggers Configuration */}
              {selectedNode.data.category === 'Scheduling & Triggers' && (
                <>
                  <div className="config-section-header">⏰ Scheduler Configuration</div>

                  <div className="config-field">
                    <label>Schedule Type</label>
                    <select
                      value={selectedNode.data.scheduleType || 'cron'}
                      onChange={(e) => updateNodeData(selectedNode.id, { scheduleType: e.target.value })}
                    >
                      <option value="cron">Cron Expression</option>
                      <option value="interval">Interval</option>
                      <option value="once">One-time</option>
                      <option value="event">Event-based</option>
                    </select>
                  </div>

                  {selectedNode.data.scheduleType === 'cron' && (
                    <div className="config-field">
                      <label>Cron Expression</label>
                      <input
                        type="text"
                        value={selectedNode.data.cronExpression || ''}
                        onChange={(e) => updateNodeData(selectedNode.id, { cronExpression: e.target.value })}
                        placeholder="0 0 * * * (every hour)"
                      />
                      <small style={{fontSize: '11px', color: '#666', marginTop: '4px', display: 'block'}}>
                        Format: minute hour day month weekday
                      </small>
                    </div>
                  )}

                  {selectedNode.data.scheduleType === 'interval' && (
                    <div className="config-row">
                      <div className="config-field">
                        <label>Interval Value</label>
                        <input
                          type="number"
                          value={selectedNode.data.intervalValue || 60}
                          onChange={(e) => updateNodeData(selectedNode.id, { intervalValue: parseInt(e.target.value) })}
                        />
                      </div>
                      <div className="config-field">
                        <label>Unit</label>
                        <select
                          value={selectedNode.data.intervalUnit || 'seconds'}
                          onChange={(e) => updateNodeData(selectedNode.id, { intervalUnit: e.target.value })}
                        >
                          <option value="seconds">Seconds</option>
                          <option value="minutes">Minutes</option>
                          <option value="hours">Hours</option>
                          <option value="days">Days</option>
                        </select>
                      </div>
                    </div>
                  )}
                </>
              )}

              {/* Advanced Agent Features Configuration */}
              {selectedNode.data.category === 'Advanced Agent Features' && (
                <>
                  <div className="config-section-header">🤖 Advanced Agent Configuration</div>

                  <div className="config-field">
                    <label>Agent Type</label>
                    <select
                      value={selectedNode.data.agentType || 'react'}
                      onChange={(e) => updateNodeData(selectedNode.id, { agentType: e.target.value })}
                    >
                      <option value="react">ReAct (Reasoning + Acting)</option>
                      <option value="plan_execute">Plan & Execute</option>
                      <option value="reflexion">Reflexion (Self-Reflection)</option>
                      <option value="multi_agent">Multi-Agent Collaboration</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Max Iterations</label>
                    <input
                      type="number"
                      value={selectedNode.data.maxIterations || 10}
                      onChange={(e) => updateNodeData(selectedNode.id, { maxIterations: parseInt(e.target.value) })}
                    />
                  </div>

                  <div className="config-field">
                    <label>Available Tools (comma-separated)</label>
                    <input
                      type="text"
                      value={selectedNode.data.availableTools || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { availableTools: e.target.value })}
                      placeholder="web_search, calculator, sql_query"
                    />
                  </div>

                  <div className="config-field">
                    <label>Memory Configuration (JSON)</label>
                    <textarea
                      value={selectedNode.data.memoryConfig || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { memoryConfig: e.target.value })}
                      rows={4}
                      placeholder='{"type": "buffer", "max_tokens": 2000}'
                      style={{ fontFamily: 'Consolas, Monaco, monospace', fontSize: '13px' }}
                    />
                  </div>
                </>
              )}

              {/* Multimodal Configuration */}
              {selectedNode.data.category === 'Multimodal' && (
                <>
                  <div className="config-section-header">🎨 Multimodal Configuration</div>

                  <div className="config-field">
                    <label>Model Provider</label>
                    <select
                      value={selectedNode.data.multimodalProvider || 'openai'}
                      onChange={(e) => updateNodeData(selectedNode.id, { multimodalProvider: e.target.value })}
                    >
                      <option value="openai">OpenAI (DALL-E, Whisper)</option>
                      <option value="stability">Stability AI</option>
                      <option value="elevenlabs">ElevenLabs (TTS)</option>
                      <option value="anthropic">Anthropic (Vision)</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Quality / Size</label>
                    <select
                      value={selectedNode.data.quality || 'standard'}
                      onChange={(e) => updateNodeData(selectedNode.id, { quality: e.target.value })}
                    >
                      <option value="low">Low (Fast)</option>
                      <option value="standard">Standard</option>
                      <option value="high">High (HD)</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Prompt / Input</label>
                    <textarea
                      value={selectedNode.data.multimodalPrompt || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { multimodalPrompt: e.target.value })}
                      rows={4}
                      placeholder="Describe the image to generate or text to convert..."
                    />
                  </div>
                </>
              )}

              {/* Analysis Configuration */}
              {selectedNode.data.category === 'Analysis' && (
                <>
                  <div className="config-section-header">📊 Analysis Configuration</div>

                  <div className="config-field">
                    <label>Analysis Type</label>
                    <select
                      value={selectedNode.data.analysisType || 'similarity'}
                      onChange={(e) => updateNodeData(selectedNode.id, { analysisType: e.target.value })}
                    >
                      <option value="similarity">Similarity Matching</option>
                      <option value="sentiment">Sentiment Analysis</option>
                      <option value="classification">Classification</option>
                      <option value="scoring">Scoring</option>
                      <option value="pattern">Pattern Detection</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Threshold Score</label>
                    <input
                      type="number"
                      min="0"
                      max="1"
                      step="0.1"
                      value={selectedNode.data.thresholdScore || 0.7}
                      onChange={(e) => updateNodeData(selectedNode.id, { thresholdScore: parseFloat(e.target.value) })}
                    />
                  </div>

                  <div className="config-field">
                    <label>Reference Data / Benchmarks</label>
                    <textarea
                      value={selectedNode.data.referenceData || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { referenceData: e.target.value })}
                      rows={4}
                      placeholder="Paste reference data or benchmark values..."
                    />
                  </div>
                </>
              )}

              {/* LLMOps & Monitoring Configuration */}
              {selectedNode.data.category === 'LLMOps & Monitoring' && (
                <>
                  <div className="config-section-header">📈 Monitoring Configuration</div>

                  <div className="config-field">
                    <label>Metric Type</label>
                    <select
                      value={selectedNode.data.metricType || 'cost'}
                      onChange={(e) => updateNodeData(selectedNode.id, { metricType: e.target.value })}
                    >
                      <option value="cost">Cost Tracking</option>
                      <option value="latency">Latency Monitoring</option>
                      <option value="cache">Cache Performance</option>
                      <option value="quality">Output Quality</option>
                    </select>
                  </div>

                  <div className="config-field">
                    <label>Alert Threshold</label>
                    <input
                      type="text"
                      value={selectedNode.data.alertThreshold || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { alertThreshold: e.target.value })}
                      placeholder="e.g., $100, 5000ms, 80%"
                    />
                  </div>

                  <div className="config-field">
                    <label>Alert Webhook URL</label>
                    <input
                      type="text"
                      value={selectedNode.data.alertWebhook || ''}
                      onChange={(e) => updateNodeData(selectedNode.id, { alertWebhook: e.target.value })}
                      placeholder="https://hooks.slack.com/..."
                    />
                  </div>
                </>
              )}

              {/* Save & Delete Actions */}
              <div className="config-actions">
                <button
                  className="save-node-btn"
                  onClick={() => {
                    setShowConfigPanel(false);
                  }}
                >
                  ✓ Save Configuration
                </button>

                <button
                  className="delete-node-btn"
                  onClick={() => {
                    deleteNode(selectedNode.id);
                    setShowConfigPanel(false);
                    setSelectedNode(null);
                  }}
                >
                  <Trash2 size={16} /> Delete Node
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

export default WorkflowBuilder;
