{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt && cd react-frontend && npm install && npm run build"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "gunicorn flask_app:app --bind 0.0.0.0:$PORT --workers 4 --timeout 120",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/config",
    "healthcheckTimeout": 100
  }
}
